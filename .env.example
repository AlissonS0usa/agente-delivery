# Copie este arquivo para .env e preencha a chave. Nunca suba o .env para o GitHub.

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=coloque_sua_chave_aqui
LLM_MODEL=openai/gpt-oss-120b

# Alternativas (descomente para trocar de provedor):
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#          LLM_MODEL=<nome de um modelo Flash gratuito, confira no Google AI Studio>
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1
#          LLM_MODEL=qwen3:8b

# Busca nas políticas: tfidf (padrão) ou embeddings (precisa de sentence-transformers)
RETRIEVER=tfidf
